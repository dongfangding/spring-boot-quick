<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ddf.boot.quickstart.core.infra.mapper.SysDictMapper">
    <select id="selectByDictTypeCode" resultMap="BaseResultMap">
        select *
        from sys_dict
        where dict_type_code = #{dictTypeCode}
          and active = 1
        order by sort asc
    </select>
</mapper>
